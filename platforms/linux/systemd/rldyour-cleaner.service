[Unit]
Description=Native unused-cache GC (artifact inventory only)
Documentation=https://github.com/NDDev-OpenNetwork/rldyour-cleaner
ConditionPathExists=%h/.local/bin/rldyour-cleaner

[Service]
Type=oneshot
# Idle-class everything: a janitor must never contend with the builds it
# cleans up after.
Nice=19
IOSchedulingClass=idle
# Bound the entire oneshot in addition to native command deadlines.
TimeoutStartSec=5min
UMask=0077
MemoryMax=512M
ExecStart=%h/.local/bin/rldyour-cleaner run
# The unit's PATH is minimal by default; user-installed toolchains (uv, go,
# pnpm) live under %h, and the cleaner delegates cache GC to them when found.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/go/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin

# Hardening — seccomp-based only. Namespace/capability directives
# (ProtectSystem, PrivateDevices, CapabilityBoundingSet, ...) need userns
# support that some user managers lack (they fail with 218/CAPABILITIES or
# get ignored), so the sandbox boundary stays inside the tool: roots
# allowlist, protect list, symlink/mount refusal.
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
