<?xml version="1.0" encoding="UTF-8"?>
<!--
  rldyour-cleaner — launchd agent for macOS

  Daily at 03:00 local; launchd fires a job missed during sleep at wake, so
  laptops stay covered. Everything runs at background priority — a janitor
  must never contend with the builds it cleans up after.

  Installed by install.sh; @HOME@ is substituted then:

    sed "s|@HOME@|${HOME}|g" io.nddev.rldyour-cleaner.plist \
        > ~/Library/LaunchAgents/io.nddev.rldyour-cleaner.plist
    launchctl bootstrap gui/"$(id -u)" \
        ~/Library/LaunchAgents/io.nddev.rldyour-cleaner.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.nddev.rldyour-cleaner</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/rldyour-cleaner</string>
        <string>run</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Only the clock starts it; install.sh kickstarts the first run. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Idle-class everything. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>19</integer>

    <!-- launchd's PATH is bare; user-installed toolchains (uv, go, pnpm)
         live under $HOME, and the liveness probe needs lsof's sbin dir. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.cargo/bin:@HOME@/go/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/rldyour-cleaner/out.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/rldyour-cleaner/err.log</string>
</dict>
</plist>
